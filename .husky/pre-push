# Keep the committed OpenAPI spec in sync with the API router: regenerate it
# and abort the push when the committed file would change, so the spec can
# never go stale. Run `pnpm gen:openapi && git add src/server/api/openapi.generated.json`
# to fix, then push again.
pnpm gen:openapi
if ! git diff --exit-code --quiet -- src/server/api/openapi.generated.json; then
  echo "✖ src/server/api/openapi.generated.json is out of date."
  echo "  Run: pnpm gen:openapi && git add src/server/api/openapi.generated.json"
  exit 1
fi
