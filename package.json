{
  "name": "split",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "just-build": "next build",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:verify-seed-hash": "tsx src/dummies/index.ts --strict",
    "prisma:prod": "prisma migrate deploy",
    "dev": "next dev",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "lint": "oxlint --type-aware",
    "start": "sleep 3 && pnpm prisma:prod && next start",
    "start-with-latest-migrations": "prisma migrate deploy && next start",
    "d": "pnpm dx && pnpm dev",
    "dx": "pnpm i && pnpm dx:up && pnpm db:dev",
    "dx:up": "bash scripts/dev-db.sh up",
    "dx:down": "bash scripts/dev-db.sh down",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch",
    "test:db:up": "tsx scripts/test-db.ts up",
    "test:db:down": "tsx scripts/test-db.ts down",
    "test:e2e:db:up": "tsx scripts/test-db.ts up e2e",
    "test:e2e:db:down": "tsx scripts/test-db.ts down e2e",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:integration:watch": "jest --config jest.integration.config.ts --watch",
    "test:e2e": "PWTEST_CACHE_DIR=node_modules/.cache/playwright playwright test",
    "prepare": "husky"
  },
